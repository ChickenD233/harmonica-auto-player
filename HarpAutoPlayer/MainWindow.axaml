<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HarpAutoPlayer"
        x:Class="HarpAutoPlayer.MainWindow"
        Title="口琴自动演奏器（三角洲行动）"
        Width="1080" Height="680"
        MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushCanvas}"
        FontFamily="{DynamicResource FontUi}"
        Closing="OnClosing">

  <Window.Styles>
    <!-- 强制浅色界面：文字色写死为深色，避免系统深色/高对比主题下白字白底看不见。
         注意：下面这几条「带 class」的规则必须排在全量规则之后，否则会被全量规则盖掉。 -->
    <Style Selector="Window">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Window CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <!-- 例外：弱化的文字角色 -->
    <Style Selector="Window TextBlock.sectionLabel">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style Selector="Window TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <Style Selector="Window TextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>
    <!-- 例外：主按钮上的白字 -->
    <Style Selector="Window Button.accent">
      <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
    </Style>
  </Window.Styles>

  <Grid>

    <!-- ============ 主界面（左：文件/轨道；右：演奏控制） ============ -->
    <DockPanel Margin="14">

    <!-- ============ 底部免责声明（点击可关闭） ============ -->
    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Background="{DynamicResource BrushDangerSoft}"
            BorderBrush="{DynamicResource BrushDangerBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8"
            PointerPressed="Disclaimer_PointerPressed" Cursor="Hand">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}"
                   Foreground="{DynamicResource BrushDangerText}" VerticalAlignment="Center">
          <Run FontWeight="Bold" Text="⚠ "/><Run Text="虚拟输入违反游戏规则，有账号封禁风险，请谨慎使用，风险自负"/>
        </TextBlock>
        <TextBlock Grid.Column="1" Text="✕" FontSize="{DynamicResource FontSmall}"
                   Foreground="{DynamicResource BrushDangerText}" Opacity="0.7"
                   Margin="12,0,2,0" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- ================= 左栏：文件 → 轨道 ================= -->
    <Grid Width="440" RowDefinitions="Auto,*" DockPanel.Dock="Left" Margin="0,0,12,0">

      <Border Grid.Row="0" Classes="card">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <!-- 首要操作：给足视觉重量（原来是灰按钮，看起来像次要操作） -->
          <Button x:Name="BtnOpen" Content="打开 MIDI 文件…" Click="BtnOpen_Click"
                  Classes="accent" Padding="14,7" FontSize="{DynamicResource FontBody}"/>
          <TextBlock Grid.Column="1" x:Name="LblFile" VerticalAlignment="Center"
                     Margin="12,0,0,0" Text="未选择文件" Classes="caption"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="sectionLabel" Margin="0,8,0,0"
                     Text="支持 .mid / .midi / .kar / .rmi"/>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="card" Margin="{DynamicResource CardGap}" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <!-- 列头：独立成一条下沉的浅色横条，和轨道行分开 -->
          <Border Classes="tableHead">
            <Grid ColumnDefinitions="22,24,28,62,*,56,42,70">
              <TextBlock Text="" FontSize="{DynamicResource FontMicro}"/>
              <TextBlock Grid.Column="1" Text="合" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="2,7" FontWeight="SemiBold"
                         ToolTip.Tip="勾选多个声部一起吹；编号=优先级，越靠前越优先，冲突时先吹编号小的"/>
              <TextBlock Grid.Column="2" Text="轨" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="3" Text="声道" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="4" Text="名称" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="5" Text="时长" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="6" Text="音符" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="7" Text="音域" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"
                         Padding="4,7" FontWeight="SemiBold"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <ListBox x:Name="TrackList" SelectionMode="Single" Background="Transparent"
                     SelectionChanged="TrackList_SelectionChanged">
              <ListBox.Styles>
                <!-- 打击乐等不适合口琴的轨道：整行禁用（不可点选、合奏勾选禁用） -->
                <Style Selector="ListBoxItem">
                  <Setter Property="IsEnabled" Value="{Binding IsPlayable}"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="22,24,28,62,*,56,42,70" MinHeight="30">
                    <TextBlock Text="{Binding MixRank}" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource BrushInfoText}"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsMix}"/>
                    <TextBlock Text="●" FontSize="{DynamicResource FontMicro}" Foreground="{DynamicResource BrushAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding ShowStar}"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsMix}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Checked="Mix_Changed" Unchecked="Mix_Changed"
                              ToolTip.Tip="勾选进合奏；再勾第二个会排在后面（2号）"/>
                    <TextBlock Grid.Column="2" Text="{Binding TrackLabel}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}"/>
                    <TextBlock Grid.Column="3" Text="{Binding ChannelLabel}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}"/>
                    <TextBlock Grid.Column="4" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}" TextTrimming="CharacterEllipsis"
                               FontWeight="{Binding NameWeight}"
                               ToolTip.Tip="{Binding DisplayName}"/>
                    <TextBlock Grid.Column="5" Text="{Binding DurationText}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontCaption}" Classes="sectionLabel"/>
                    <TextBlock Grid.Column="6" Text="{Binding NoteCount}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="{Binding RangeLabel}" VerticalAlignment="Center"
                               Padding="4,3" FontSize="{DynamicResource FontSmall}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- 空状态引导：没有载入 MIDI 时，别留一大片什么都没有的白 -->
            <TextBlock x:Name="EmptyHint" IsVisible="True"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                       Classes="caption" LineHeight="22"
                       Text="还没有载入曲目&#x0a;点左上角「打开 MIDI 文件…」选一首，再点一行作为主旋律"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= 右栏：演奏 ================= -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

      <!-- 第 0 行：有新版本时的提示条 + 主旋律信息（同一行内纵向排列，避免重叠） -->
      <StackPanel Grid.Row="0">
        <Border x:Name="UpdateBanner" IsVisible="False" Classes="card"
                Margin="0,0,0,12" Padding="12,9" Background="{DynamicResource BrushInfoSoft}"
                BorderBrush="{DynamicResource BrushInfoBorder}"
                Cursor="Hand" PointerPressed="UpdateBanner_PointerPressed">
          <TextBlock x:Name="TxtUpdate" TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}"
                     Foreground="{DynamicResource BrushInfoText}"
                     LineHeight="20" Text=""/>
        </Border>
        <Border Classes="card">
          <StackPanel>
            <TextBlock x:Name="LblMelody" TextWrapping="Wrap" FontSize="{DynamicResource FontBody}" LineHeight="22"
                       Text="打开 MIDI 文件，并在左侧单击一行作为主旋律。"/>
            <TextBlock x:Name="LblWarn" TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" Margin="0,4,0,0" Text=""/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 状态区：整个界面的视觉锚点，字号/颜色由代码按状态切换。
           居中用 TextAlignment（让 TextBlock 撑满卡片内宽再居中），长句才会正常换行。 -->
      <Border Grid.Row="1" Classes="card" Margin="{DynamicResource CardGap}" Padding="16,14">
        <TextBlock x:Name="LblStatus" FontSize="{DynamicResource FontDisplay}" FontWeight="Bold"
                   Foreground="{DynamicResource BrushSuccess}"
                   TextAlignment="Center" Text="" TextWrapping="Wrap"/>
      </Border>

      <Border Grid.Row="2" Classes="card" Margin="{DynamicResource CardGap}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="BtnPlay" Content="▶ 播放 (F6)" Click="BtnPlay_Click"
                    Classes="accent" FontSize="{DynamicResource FontTitle}" Padding="20,8" IsEnabled="False"/>
            <Button x:Name="BtnStop" Content="■ 停止" Click="BtnStop_Click"
                    Classes="secondary" FontSize="{DynamicResource FontTitle}" Padding="20,8" IsEnabled="False"/>
            <CheckBox x:Name="ChkLoop" Content="循环" VerticalAlignment="Center" FontSize="{DynamicResource FontBody}"/>
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="16,0,0,0">
            <Slider x:Name="SliderProgress" VerticalAlignment="Center" Margin="0,0,10,0"
                    Minimum="0" Maximum="1" Value="0" IsEnabled="False"/>
            <TextBlock Grid.Column="1" x:Name="TxtTime" Classes="value"
                       Text="0.0 / 0.0 s"/>
          </Grid>
          <TextBlock Grid.Column="2" x:Name="TxtHotHint" Classes="sectionLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                     Text="F6：开始 / 暂停 / 继续"/>
        </Grid>
      </Border>

      <!-- 播放前自检结果：通过打勾、未通过打叉。用 WrapPanel 让长提示自动换行（原来会被卡片右边裁掉） -->
      <Border Grid.Row="4" Classes="card" Margin="{DynamicResource CardGap}" Padding="12,9" Background="{DynamicResource BrushSurfaceAlt}">
        <WrapPanel ItemSpacing="18" LineSpacing="8">
          <TextBlock Text="播放前自检" Classes="sectionLabel" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                      ToolTip.Tip="模拟按键受 Windows 的 UIPI 限制：游戏若以管理员运行而本程序不是，按键会被系统拦截">
            <TextBlock x:Name="TxtCheckAdminMark" Text="–" FontSize="{DynamicResource FontBody}" FontWeight="Bold"
                       Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtCheckAdmin" Text="管理员" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                      ToolTip.Tip="中文/日文输入法会截走按键（尤其拼音未上屏时），请切到英文">
            <TextBlock x:Name="TxtCheckImeMark" Text="–" FontSize="{DynamicResource FontBody}" FontWeight="Bold"
                       Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtCheckIme" Text="输入法" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="TxtCheckHint" Classes="caption" Foreground="{DynamicResource BrushWarn}"
                     VerticalAlignment="Center"/>
          <Button x:Name="BtnRecheck" Content="刷新" FontSize="{DynamicResource FontCaption}" Padding="10,3"
                  Classes="secondary" VerticalAlignment="Center" Click="BtnRecheck_Click"
                  ToolTip.Tip="重新检测管理员权限与当前输入法（切换输入法后点一下即可）"/>
        </WrapPanel>
      </Border>

      <!-- 选项区：三行分组，避免一个 WrapPanel 里堆十几个控件 -->
      <StackPanel Grid.Row="3" Spacing="10" Margin="{DynamicResource CardGap}">

        <!-- 第 1 行：演奏参数 -->
        <Border Classes="card" Padding="14,10">
          <WrapPanel ItemSpacing="22" LineSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="速度" Classes="label" MinWidth="34"/>
              <Slider x:Name="SliderSpeed" Width="126" Minimum="50" Maximum="200" Value="100"
                      TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged"
                      VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtSpeed" Text="100%" Classes="value" Width="40"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="移调" Classes="label" MinWidth="34"/>
              <Slider x:Name="SliderTranspose" Width="126" Minimum="-10" Maximum="10" Value="0"
                      TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged"
                      VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtTranspose" Text="0" Classes="value" Width="32"/>
            </StackPanel>

            <Button x:Name="BtnAutoTranspose" Content="一键移调" FontSize="{DynamicResource FontSmall}"
                    Padding="12,5" Classes="secondary" VerticalAlignment="Center"
                    Click="BtnAutoTranspose_Click"
                    ToolTip.Tip="自动找到让所有音都在口琴音域内的移调量"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="倒计时" Classes="label" MinWidth="46"/>
              <ComboBox x:Name="CountdownCombo" Width="104" FontSize="{DynamicResource FontSmall}" SelectedIndex="1"
                        VerticalAlignment="Center" SelectionChanged="CountdownCombo_Changed"/>
            </StackPanel>
          </WrapPanel>
        </Border>

        <!-- 第 2 行：兼容性与导出 -->
        <Border Classes="card" Padding="14,10">
          <WrapPanel ItemSpacing="22" LineSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="输入兼容" Classes="label"
                         ToolTip.Tip="游戏按键是按帧读取的：修饰键与音键间隔太短会被折进同一帧，导致漏音。这里给出时间余量。"/>
              <ComboBox x:Name="TimingCombo" Width="158" FontSize="{DynamicResource FontSmall}" SelectedIndex="1"
                        VerticalAlignment="Center" SelectionChanged="Timing_Changed"
                        ToolTip.Tip="稳健=给30fps/掉帧留余量；标准=60fps 推荐；极限=高帧率下跟快歌。若仍漏音请选「稳健」。"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="控制热键" Classes="label"
                         ToolTip.Tip="同一个键：空闲按它=开始；播放中按它=暂停；暂停中按它=继续；倒计时中按它=取消。默认 F6"/>
              <ComboBox x:Name="HotkeyControlCombo" Width="86" FontSize="{DynamicResource FontSmall}"
                        VerticalAlignment="Center" SelectionChanged="Hotkey_Changed"
                        ToolTip.Tip="同一个键：空闲按=开始；播放中按=暂停；暂停中按=继续；倒计时中按=取消"/>
            </StackPanel>

            <Button x:Name="BtnExport" Content="导出按键表 ▾" FontSize="{DynamicResource FontSmall}"
                    Padding="12,5" Classes="secondary" VerticalAlignment="Center" IsEnabled="False"
                    ToolTip.Tip="把这首曲子的按键时序导出成文件，内容与程序实际演奏完全一致。点开选择格式">
              <Button.Flyout>
                <MenuFlyout Placement="Bottom">
                  <MenuItem Header="罗技 G HUB 脚本 (.lua)" Click="ExportGhub_Click"/>
                  <MenuItem Header="通用 CSV (.csv)" Click="ExportCsv_Click"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </WrapPanel>
        </Border>

        <!-- 第 3 行：其它选项 -->
        <Border Classes="card" Padding="14,10">
          <WrapPanel ItemSpacing="20" LineSpacing="6">
            <CheckBox x:Name="ChkChordRoot" Content="自动提取主旋律" FontSize="{DynamicResource FontBody}"
                      IsChecked="True" VerticalAlignment="Center"
                      ToolTip.Tip="口琴一次只能吹一个音。开：先分出伴奏/旋律各声部，再挑最像主旋律的那条（钢琴/吉他改编曲也能认出旋律）；关：不做处理，同刻多音按原样交给下面逻辑"
                      IsCheckedChanged="Option_Changed"/>
            <CheckBox x:Name="ChkVocalExtract" Content="人声旋律提取" FontSize="{DynamicResource FontBody}"
                      IsChecked="False" VerticalAlignment="Center"
                      ToolTip.Tip="伴奏与主唱混在同一轨时用：只在人声音区里取音并保持旋律连续，过滤低音/和声伴奏"
                      IsCheckedChanged="Option_Changed"/>
            <CheckBox x:Name="ChkTrimLead" Content="去除开头空拍" FontSize="{DynamicResource FontBody}"
                      IsChecked="True" VerticalAlignment="Center"
                      ToolTip.Tip="很多 MIDI 开头有几小节休止/空白：勾选后自动把起始静音剪掉，让旋律从第 0 秒直接开始"
                      IsCheckedChanged="Option_Changed"/>
            <CheckBox x:Name="ChkBreath" Content="呼吸休止" FontSize="{DynamicResource FontBody}"
                      IsChecked="False" VerticalAlignment="Center"
                      ToolTip.Tip="连续吹奏过久自动插入极短停顿，避免长连吹导致游戏判定粘连"
                      IsCheckedChanged="Breath_Changed"/>
            <CheckBox x:Name="ChkAutoMinimize" Content="播放后自动最小化窗口" FontSize="{DynamicResource FontBody}"
                      IsChecked="True" VerticalAlignment="Center"
                      ToolTip.Tip="勾选：开始播放后窗口自动最小化到任务栏；不勾选：窗口保持原样（放副屏上看进度/歌词时用，记得点一下游戏画面让游戏拿到焦点）"
                      IsCheckedChanged="AutoMinimize_Changed"/>
          </WrapPanel>
        </Border>
      </StackPanel>

      <Border Grid.Row="5" Classes="card" Margin="{DynamicResource CardGap}" Padding="12,9" Background="{DynamicResource BrushSurfaceAlt}">
        <ListBox x:Name="LogList"/>
      </Border>
    </Grid>
  </DockPanel>

  <!-- ============ 首次启动“快速上手”浮层（点“我知道了”后不再弹出） ============ -->
  <Border x:Name="QuickStartOverlay" IsVisible="False" Background="#66101828" CornerRadius="0">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Margin="24">
      <Border Classes="card" Padding="26,22">
        <StackPanel Spacing="10">
          <TextBlock Text="快速上手（第一次使用，之后不再弹出）" FontSize="18" FontWeight="Bold"/>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontBody}" LineHeight="22">
            <Run FontWeight="Bold" Text="① 打开 MIDI"/><Run Text="：点「打开 MIDI 文件」，程序会替你选好一条推荐的主旋律轨（绿点标出）；歌曲有多条声部时想换就点其它行；"/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontBody}" LineHeight="22">
            <Run FontWeight="Bold" Text="② 开始"/><Run Text="：点「▶ 播放」或直接按 F6，看清大号倒计时，在结束前切换到游戏并装备口琴即可自动吹奏；"/>
          </TextBlock>
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontBody}" LineHeight="22">
            <Run FontWeight="Bold" Text="③ 暂停 / 继续"/><Run Text="：整个控制就一个键——F6 空闲开始、播放中暂停、暂停中继续，再按一下 F6 就能停；播放中的「▶」按钮也会变成「⏸」。"/>
          </TextBlock>
          <Border Background="{DynamicResource BrushWarnSoft}" BorderBrush="{DynamicResource BrushWarnBorder}"
                  BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="几个易踩的坑：" FontWeight="Bold" FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource BrushWarn}"/>
              <TextBlock Text="· 游戏用窗口化或无边框窗口化，不要用全屏独占" FontSize="{DynamicResource FontBody}"/>
              <TextBlock Text="· 输入法切到英文；游戏内人物请原地站好再开始" FontSize="{DynamicResource FontBody}"/>
              <TextBlock Text="· 没反应时先点一下游戏画面；游戏以管理员运行时，本程序也要以管理员运行" FontSize="{DynamicResource FontBody}"/>
              <TextBlock Text="· 想先验证按键对不对：可打开仓库里的 口琴钢琴测试台.html" FontSize="{DynamicResource FontBody}"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnQuickStartOk" Content="我知道了，开始使用" Classes="accent"
                  HorizontalAlignment="Right" Padding="18,8" FontSize="{DynamicResource FontTitle}" Margin="0,6,0,0"
                  Click="QuickStartOk_Click"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Grid>
</Window>
