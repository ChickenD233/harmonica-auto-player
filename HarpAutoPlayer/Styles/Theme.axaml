<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== 调色板（唯一真源） =====================
       换配色只改这里，MainWindow 里不再出现裸 #RRGGBB；品牌绿需与 App.axaml 的 SystemAccentColor 保持一致。 -->

  <!-- 背景与表面 -->
  <SolidColorBrush x:Key="BrushCanvas"       Color="#F4F6F9"/>
  <SolidColorBrush x:Key="BrushSurface"      Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrushSurfaceAlt"   Color="#F8FAFC"/>
  <SolidColorBrush x:Key="BrushSurfaceSunken" Color="#F7F8FA"/>
  <SolidColorBrush x:Key="BrushBorder"       Color="#E4E8EE"/>
  <SolidColorBrush x:Key="BrushBorderStrong" Color="#D3DAE3"/>

  <!-- 文字 -->
  <SolidColorBrush x:Key="BrushText"          Color="#1F2933"/>
  <SolidColorBrush x:Key="BrushTextSecondary" Color="#5B6673"/>
  <SolidColorBrush x:Key="BrushTextMuted"     Color="#8A93A0"/>

  <!-- 品牌绿 -->
  <SolidColorBrush x:Key="BrushAccent"         Color="#2E8B57"/>
  <SolidColorBrush x:Key="BrushAccentHover"    Color="#26784A"/>
  <SolidColorBrush x:Key="BrushAccentPressed"  Color="#1F6540"/>
  <SolidColorBrush x:Key="BrushAccentDisabled" Color="#AECBBC"/>
  <SolidColorBrush x:Key="BrushAccentSoft"     Color="#E8F3EC"/>
  <SolidColorBrush x:Key="BrushOnAccent"       Color="#FFFFFF"/>

  <!-- 语义色 -->
  <SolidColorBrush x:Key="BrushSuccess" Color="#1E7A3C"/>
  <SolidColorBrush x:Key="BrushWarn"    Color="#B25A00"/>
  <SolidColorBrush x:Key="BrushDanger"  Color="#C0392B"/>

  <!-- 提示条 -->
  <SolidColorBrush x:Key="BrushDangerSoft"   Color="#FDF1EF"/>
  <SolidColorBrush x:Key="BrushDangerBorder" Color="#F0CFC9"/>
  <SolidColorBrush x:Key="BrushDangerText"   Color="#A32B22"/>
  <SolidColorBrush x:Key="BrushWarnSoft"     Color="#FFF7E8"/>
  <SolidColorBrush x:Key="BrushWarnBorder"   Color="#F0DCB4"/>
  <SolidColorBrush x:Key="BrushInfoSoft"     Color="#EAF3FF"/>
  <SolidColorBrush x:Key="BrushInfoBorder"   Color="#BBD6F5"/>
  <SolidColorBrush x:Key="BrushInfoText"     Color="#1B4F91"/>

  <!-- 倒计时时整窗的暖色提醒底 -->
  <SolidColorBrush x:Key="BrushCountdownChrome" Color="#FFF3E4D8"/>

  <!-- ===================== 字体 =====================
       Windows 用雅黑；macOS/Linux 回退苹方/思源，避免整窗掉到默认字体。 -->
  <FontFamily x:Key="FontUi">Microsoft YaHei UI, 微软雅黑, PingFang SC, Hiragino Sans GB, Noto Sans CJK SC, Source Han Sans SC, Segoe UI, Helvetica Neue, sans-serif</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, SF Mono, Menlo, DejaVu Sans Mono, monospace</FontFamily>

  <!-- ===================== 字号刻度（原来的 7 档收敛而来） ===================== -->
  <x:Double x:Key="FontMicro">11</x:Double>
  <x:Double x:Key="FontCaption">11.5</x:Double>
  <x:Double x:Key="FontSmall">12.5</x:Double>
  <x:Double x:Key="FontBody">13.5</x:Double>
  <x:Double x:Key="FontTitle">15</x:Double>
  <x:Double x:Key="FontDisplay">22</x:Double>
  <x:Double x:Key="FontCountdown">38</x:Double>

  <!-- ===================== 圆角与间距 ===================== -->
  <CornerRadius x:Key="RadiusCard">10</CornerRadius>
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <Thickness x:Key="CardPadding">14,12</Thickness>
  <Thickness x:Key="CardGap">0,12,0,0</Thickness>

</ResourceDictionary>
